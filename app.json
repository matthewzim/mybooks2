{
  "expo": {
    "name": "Virtual Library",
    "slug": "virtual-library-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "virtuallibrary",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.virtuallibrary",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan book spines and add them to your library.",
        "NSPhotoLibraryUsageDescription": "This app accesses your photo library to upload book spine images.",
        "UIViewControllerBasedStatusBarAppearance": true
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yourcompany.virtuallibrary",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      "expo-secure-store",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "BookshelfWidget",
              "src": "./widgets/BookshelfWidget.tsx",
              "displayName": "My Bookshelf",
              "description": "Show one shelf from your library.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge"
              ]
            }
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Virtual Library to access your camera to scan book spines."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Virtual Library to access your photos to upload book spine images."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.yourcompany.virtuallibrary",
          "enableGooglePay": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
