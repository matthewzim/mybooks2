{
  "expo": {
    "name": "Virtual Library",
    "slug": "virtual-library-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "virtuallibrary",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matthewzimmerman.virtuallibrary",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan book spines and add them to your library.",
        "NSPhotoLibraryUsageDescription": "This app accesses your photo library to upload book spine images.",
        "UIViewControllerBasedStatusBarAppearance": false
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.matthewzimmerman.virtuallibrary"
        ]
      }
    },
    "android": {
      "package": "com.matthewzimmerman.virtuallibrary",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#f4ecdd"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "./plugins/withSwiftConcurrencyMinimal",
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f4ecdd",
          "dark": {
            "backgroundColor": "#1a1a2e"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.matthewzimmerman.virtuallibrary.widgets",
          "groupIdentifier": "group.com.matthewzimmerman.virtuallibrary",
          "widgets": [
            {
              "name": "BookshelfWidget",
              "displayName": "My Bookshelf",
              "description": "Show one shelf from your library.",
              "supportedFamilies": [
                "systemMedium",
                "systemLarge"
              ]
            }
          ]
        }
      ],
      "./plugins/withDeduplicateWidgetTargets",
      "./plugins/withConfigurableWidget",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Virtual Library to access your camera to scan book spines."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Virtual Library to access your photos to upload book spine images."
        }
      ],
      "./plugins/withAllowHTTPDevServer"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
