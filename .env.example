# Public values embedded in the app (never add paid provider or service-role keys).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your-revenuecat-ios-key
# Optional per-device backoff; the Edge Function enforces shared budgets.
EXPO_PUBLIC_ISBNDB_REQUESTS_PER_SECOND=1
# Server-only secrets are documented in docs/PRE_RELEASE_AUDIT.md.
