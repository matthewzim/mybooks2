# Supabase Configuration
# Get these values from your Supabase project settings
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# RevenueCat Configuration (in-app purchases & subscriptions)
# Public SDK key from RevenueCat dashboard > Project Settings > API Keys.
# Use the App Store key (appl_...) for production iOS builds.
# If unset, the app falls back to a RevenueCat test-store key that cannot
# process real purchases.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your-revenuecat-ios-key

# Optional: Google Books API Key
# Without a key, requests use unauthenticated quota (limited).
# Get a key from https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# Optional: Google Cloud Vision API Key
# Enables reading spine text to auto-fill and match the book (title/author/ISBN)
# in Scan Spine and Add Book, and powers the full bookshelf scan.
EXPO_PUBLIC_GOOGLE_CLOUD_VISION_API_KEY=your-google-vision-api-key
